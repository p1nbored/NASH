{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ack.request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "itemId": {
              "$ref": "#/$defs/__schema0"
            },
            "leaseNonce": {
              "$ref": "#/$defs/__schema1"
            },
            "generation": {
              "$ref": "#/$defs/__schema2"
            },
            "payloadSha256": {
              "$ref": "#/$defs/__schema3"
            },
            "ackedAt": {
              "$ref": "#/$defs/__schema4"
            },
            "outcome": {
              "type": "string",
