            },
            "dotRequestId": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "itemId",
            "leaseNonce",
            "generation",
            "payloadSha256",
            "ackedAt",
            "outcome",
            "dotRequestId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "itemId": {
              "$ref": "#/$defs/__schema0"
            },
            "leaseNonce": {
              "$ref": "#/$defs/__schema1"
            },
            "generation": {
              "$ref": "#/$defs/__schema2"
            },
            "payloadSha256": {
              "$ref": "#/$defs/__schema3"
            },
            "ackedAt": {
              "$ref": "#/$defs/__schema4"
            },
            "outcome": {
              "type": "string",
              "const": "duplicate"
            },
            "dotRequestId": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "itemId",
            "leaseNonce",
            "generation",
            "payloadSha256",
            "ackedAt",
            "outcome",
            "dotRequestId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "itemId": {
              "$ref": "#/$defs/__schema0"
            },
            "leaseNonce": {
              "$ref": "#/$defs/__schema1"
            },
            "generation": {
              "$ref": "#/$defs/__schema2"
            },
            "payloadSha256": {
              "$ref": "#/$defs/__schema3"
            },
            "ackedAt": {
              "$ref": "#/$defs/__schema4"
            },
            "outcome": {
              "type": "string",
              "const": "refused"
            },
            "dotRequestId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema5"
                },
                {
                  "type": "null"
                }
              ]
            },
            "refusal": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_ingress_disabled"
                    },
                    "message": {
                      "type": "string",
                      "const": "The dot interface is turned off in the app."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_ingress_forbidden"
                    },
                    "message": {
                      "type": "string",
                      "const": "This caller is not allowed to use the dot interface."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_unsupported_contract_version"
                    },
                    "message": {
                      "type": "string",
                      "const": "Unsupported contract version. Supported versions: 3."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_workspace_unknown"
                    },
                    "message": {
                      "type": "string",
                      "const": "This workspace reference is not enabled for dot requests."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_workspace_unavailable"
                    },
                    "message": {
                      "type": "string",
                      "const": "The workspace is not available right now. Local workspaces only; try again later."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_requirement_not_english"
                    },
                    "message": {
                      "type": "string",
                      "const": "Rewrite the requirement in English. Put names, paths and quotations that must not be translated inside double quotes, typographic double quotes or backticks."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_requirement_unclear"
                    },
                    "message": {
                      "type": "string",
                      "const": "The requirement is blank or has no prose outside quoted text. Describe the task in English sentences."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_requirement_too_long"
                    },
                    "message": {
                      "type": "string",
                      "const": "The requirement is too long. Shorten the prose or reduce the quoted spans."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_requirement_rejected_content"
                    },
                    "message": {
                      "type": "string",
                      "const": "The requirement was rejected because it contains content that must not leave the machine. Remove it and resubmit."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_idempotency_conflict"
                    },
                    "message": {
                      "type": "string",
                      "const": "This idempotency key was already used for a different request."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_request_not_found"
                    },
                    "message": {
                      "type": "string",
                      "const": "The request was not found."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_request_not_cancelable"
                    },
                    "message": {
                      "type": "string",
                      "const": "Only a request that was handed to the workbench and is not yet canceled can be canceled."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_capacity_exceeded"
                    },
                    "message": {
                      "type": "string",
                      "const": "Too many dot requests are waiting or stored. Try again later."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_rate_limited"
                    },
                    "message": {
                      "type": "string",
                      "const": "The submission limit set in the app was reached. Try again later."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_recovery_required"
                    },
                    "message": {
                      "type": "string",
                      "const": "The dot request store needs recovery in the app. Nothing was changed."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_decision_not_found"
                    },
                    "message": {
                      "type": "string",
                      "const": "The permission prompt was not found."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_decision_desktop_only"
                    },
                    "message": {
                      "type": "string",
                      "const": "This permission prompt can only be answered in the app."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_access_above_maximum"
                    },
                    "message": {
                      "type": "string",
                      "const": "The requested access is above the maximum the user set for this workspace. Ask for less access, or ask the user to raise the maximum in the app."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_decision_deny_only"
                    },
                    "message": {
                      "type": "string",
                      "const": "This run may only read, so dot can deny this permission prompt but not allow it. Allowing it is possible only in the app."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_request_busy"
                    },
                    "message": {
                      "type": "string",
                      "const": "The run could not be stopped yet or the request is still changing, so nothing was canceled. Try again later."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "const": "nash"
                    },
                    "code": {
                      "type": "string",
                      "const": "dot_validation_not_found"
                    },
                    "message": {
                      "type": "string",
                      "const": "The validation decision was not found."
                    }
                  },
                  "required": [
                    "by",
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "itemId",
            "leaseNonce",
            "generation",
            "payloadSha256",
            "ackedAt",
            "outcome",
            "dotRequestId",
            "refusal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "itemId": {
              "$ref": "#/$defs/__schema0"
            },
            "leaseNonce": {
              "$ref": "#/$defs/__schema1"
            },
            "generation": {
              "$ref": "#/$defs/__schema2"
            },
            "payloadSha256": {
              "$ref": "#/$defs/__schema3"
            },
            "ackedAt": {
              "$ref": "#/$defs/__schema4"
            },
            "outcome": {
              "type": "string",
              "const": "expired"
            }
          },
          "required": [
            "itemId",
            "leaseNonce",
            "generation",
            "payloadSha256",
            "ackedAt",
            "outcome"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ack.response": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "#/$defs/__schema0"
        },
        "recorded": {
          "type": "string",
          "enum": [
            "applied",
            "already_recorded"
          ]
        },
        "receiptState": {
          "type": "string",
          "enum": [
            "queued",
            "claimed",
            "accepted",
            "refused",
            "expired",
            "canceled_before_claim"
          ]
        }
      },
      "required": [
        "itemId",
        "recorded",
        "receiptState"
      ],
      "additionalProperties": false
    },
    "error.endpoint": {
      "type": "object",
      "properties": {
        "error": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "unauthorized"
                },
                "message": {
                  "type": "string",
                  "const": "This caller is not allowed to use this NASH pairing."
                },
                "retryable": {
                  "type": "string",
                  "const": "no"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "payload_invalid"
                },
                "message": {
                  "type": "string",
                  "const": "The input does not match its schema. Fix the input and try again."
                },
                "retryable": {
                  "type": "string",
                  "const": "yes"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "rate_limited"
                },
                "message": {
                  "type": "string",
                  "const": "Too many calls in a short time. Try again later."
                },
                "retryable": {
                  "type": "string",
                  "const": "later"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "session_expired"
                },
                "message": {
                  "type": "string",
                  "const": "The session expired. Renew it, or pair again if renewal fails."
                },
                "retryable": {
                  "type": "string",
                  "const": "yes"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "generation_revoked"
                },
                "message": {
                  "type": "string",
                  "const": "This pairing was revoked. Pair NASH again from the desktop app."
                },
                "retryable": {
                  "type": "string",
                  "const": "no"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "lease_lost"
                },
                "message": {
                  "type": "string",
                  "const": "This lease is no longer held. Lease the inbox again."
                },
                "retryable": {
                  "type": "string",
                  "const": "no"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "ack_conflict"
                },
                "message": {
                  "type": "string",
                  "const": "This item was already acknowledged with a different outcome."
                },
                "retryable": {
                  "type": "string",
                  "const": "no"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "challenge_not_found"
                },
                "message": {
                  "type": "string",
                  "const": "No pairing challenge with this code was found."
                },
                "retryable": {
                  "type": "string",
                  "const": "no"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "challenge_expired"
                },
                "message": {
                  "type": "string",
                  "const": "The pairing code expired. Start pairing again from the desktop app."
                },
                "retryable": {
                  "type": "string",
                  "const": "no"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "challenge_used"
                },
                "message": {
                  "type": "string",
                  "const": "The pairing code was already used. Start pairing again from the desktop app."
                },
                "retryable": {
                  "type": "string",
                  "const": "no"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "challenge_denied"
                },
                "message": {
                  "type": "string",
                  "const": "The owner declined this pairing."
                },
                "retryable": {
                  "type": "string",
                  "const": "no"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "device_credential_invalid"
                },
                "message": {
                  "type": "string",
                  "const": "This device credential is not valid. Pair NASH again from the desktop app."
                },
                "retryable": {
                  "type": "string",
                  "const": "no"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "device_credential_reused"
                },
                "message": {
                  "type": "string",
                  "const": "This device credential was already replaced, so the pairing was revoked to protect it. Pair NASH again from the desktop app."
                },
                "retryable": {
                  "type": "string",
                  "const": "no"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "pairing_expired"
                },
                "message": {
                  "type": "string",
                  "const": "This pairing reached its maximum lifetime. Pair NASH again from the desktop app."
                },
                "retryable": {
                  "type": "string",
                  "const": "no"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ack.request",
    "ack.response",
    "error.endpoint"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,86}$"
    },
    "__schema2": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "__schema4": {
      "type": "string",
