{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "heartbeat.request": {
      "type": "object",
      "properties": {
        "generation": {
          "$ref": "#/$defs/__schema0"
        },
        "appVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "contractVersion": {
          "type": "number",
          "const": 4
        },
        "sentAt": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "generation",
        "appVersion",
        "contractVersion",
        "sentAt"
      ],
      "additionalProperties": false
    },
    "heartbeat.response": {
      "type": "object",
      "properties": {
        "serverTime": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "serverTime"
      ],
      "additionalProperties": false
    },
    "workspaces.request": {
      "type": "object",
      "properties": {
        "generation": {
          "$ref": "#/$defs/__schema0"
        },
        "publishedAt": {
          "$ref": "#/$defs/__schema2"
        },
        "workspaces": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "generation",
        "publishedAt",
        "workspaces"
      ],
      "additionalProperties": false
    },
    "workspaces.response": {
      "type": "object",
      "properties": {
        "storedAt": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "storedAt"
      ],
      "additionalProperties": false
    },
    "view.status": {
      "type": "object",
      "properties": {
        "paired": {
          "$ref": "#/$defs/__schema5"
        },
        "online": {
          "$ref": "#/$defs/__schema6"
        },
        "lastSeenAt": {
          "$ref": "#/$defs/__schema7"
        },
        "appVersion": {
          "$ref": "#/$defs/__schema8"
        },
        "contractVersion": {
          "$ref": "#/$defs/__schema9"
        },
        "onlineWindowSeconds": {
          "$ref": "#/$defs/__schema10"
        },
        "manifestSha256": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": [
        "paired",
        "online",
        "lastSeenAt",
        "appVersion",
        "contractVersion",
        "onlineWindowSeconds",
        "manifestSha256"
      ],
      "additionalProperties": false
    },
    "view.workspaces": {
      "type": "object",
      "properties": {
        "workspaces": {
          "$ref": "#/$defs/__schema3"
        },
        "publishedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema2"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "workspaces",
        "publishedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "heartbeat.request",
    "heartbeat.response",
    "workspaces.request",
    "workspaces.response",
    "view.status",
    "view.workspaces"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]{1,32}$"
    },
    "__schema2": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema3": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "workspaceRef": {
          "type": "string",
          "pattern": "^dws_[0-9a-f]{24}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\p{Cc}\\p{Zl}\\p{Zp}\\\\/]+$"
        },
        "maxAccess": {
          "type": "string",
          "enum": [
            "read_only",
            "workspace_write"
          ]
        }
      },
      "required": [
        "workspaceRef",
        "displayName",
        "maxAccess"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "boolean"
    },
    "__schema6": {
      "type": "boolean"
    },
    "__schema7": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema2"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema8": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema9": {
      "anyOf": [
        {
          "type": "number",
          "const": 4
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema10": {
      "type": "number",
      "const": 90
    },
    "__schema11": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
